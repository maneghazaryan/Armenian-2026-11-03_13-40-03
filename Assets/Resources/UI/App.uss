/* Palette: apricot #F28C38, deep red #B5332E, ink #2B2A33, paper #FFF8F0 */

.app { background-color: #FFF8F0; color: #2B2A33; font-size: 28px; flex-grow: 1; }
.screen-host { flex-grow: 1; }
.screen { flex-grow: 1; padding: 24px 28px; }
.grow { flex-grow: 1; flex-shrink: 1; }
.center { -unity-text-align: middle-center; white-space: normal; }
.muted { color: #8A8794; font-size: 24px; }
.body { font-size: 28px; white-space: normal; margin: 8px 0; }
.title { font-size: 40px; -unity-font-style: bold; white-space: normal; margin: 8px 0; }

/* ---------- buttons ---------- */
.btn {
    border-width: 0; border-radius: 18px; margin: 6px 0; padding: 14px 24px;
    font-size: 28px; -unity-font-style: bold; color: #2B2A33; background-color: #FFFFFF;
    transition-duration: 0.1s; transition-property: scale, background-color;
}
.btn:active { scale: 0.97 0.97; }
.btn-primary { background-color: #F28C38; color: #FFFFFF; }
.btn-secondary { background-color: #FFE7D1; color: #B5332E; }
.btn-ghost { background-color: rgba(0,0,0,0); color: #B5332E; }
.btn-icon { background-color: rgba(0,0,0,0); font-size: 36px; padding: 4px 16px; margin-right: 12px; }
.btn-play {
    width: 120px; height: 120px; border-radius: 60px; align-self: center;
    background-color: #F28C38; color: #FFFFFF; font-size: 48px; margin: 16px;
}
.small { font-size: 22px; padding: 6px 12px; align-self: center; }
.wide { width: 100%; padding: 20px; font-size: 32px; }

/* ---------- home ---------- */
.header { align-items: center; margin-bottom: 20px; }
.logo { font-size: 96px; color: #B5332E; -unity-font-style: bold; }
.subtitle { font-size: 32px; margin-bottom: 4px; }
.day-card {
    flex-direction: row; align-items: center; background-color: #FFFFFF;
    border-radius: 22px; padding: 18px 22px; margin-bottom: 14px;
    border-left-width: 8px; border-color: #FFE7D1;
}
.day-done { border-color: #5BAE6A; }
.day-available { border-color: #F28C38; }
.day-locked, .day-lockeduntiltomorrow { opacity: 0.55; }
.recall-offer { justify-content: center; align-items: center; padding: 0 40px; }
.optional-tag { font-size: 20px; color: #5B8FC7; margin-top: 2px; }
.day-skipped { opacity: 0.55; border-color: #C9C5CF; }
.skip { align-self: flex-start; margin: 6px 0 0 0; padding: 4px 0; font-size: 22px; color: #8A8794; }
.day-title { font-size: 28px; -unity-font-style: bold; white-space: normal; }
.day-letters { font-size: 34px; color: #B5332E; margin-top: 4px; }
.lock { color: #8A8794; font-size: 30px; }
.stars { color: #F2A900; font-size: 30px; }
.footer { flex-direction: row; align-items: center; padding-top: 12px; }
.toggle { margin-left: 20px; font-size: 22px; }
.toggle Label { font-size: 22px; min-width: 0; }

/* ---------- alphabet ---------- */
.topbar { flex-direction: row; align-items: center; margin-bottom: 16px; }
.letter-detail { min-height: 200px; justify-content: center; margin-bottom: 12px; }
.letter-grid { flex-direction: row; flex-wrap: wrap; justify-content: center; }
.letter-cell {
    width: 120px; height: 96px; margin: 6px; font-size: 34px; -unity-font-style: normal;
    background-color: #F0ECE6; color: #A8A4AE;
}
.letter-cell.learned { background-color: #FFFFFF; color: #B5332E; border-width: 2px; border-color: #F28C38; }

/* ---------- letter card ---------- */
.letter-card {
    align-items: center; background-color: #FFFFFF; border-radius: 28px;
    padding: 24px; margin: 12px 0;
}
.glyph-xl { font-size: 180px; color: #B5332E; -unity-text-align: middle-center; }
.glyph-md { font-size: 80px; color: #B5332E; -unity-text-align: middle-center; }
.letter-name { font-size: 32px; -unity-font-style: bold; margin: 8px 0; }
.letter-top { flex-direction: row; align-items: center; justify-content: center; }
.letter-pic { font-size: 120px; margin-left: 28px; -unity-text-align: middle-center; }
.letter-pic-md { font-size: 64px; margin-left: 20px; -unity-text-align: middle-center; }
.intro-letters { flex-direction: row; flex-wrap: wrap; justify-content: center; margin: 12px 0; }
.intro-letter {
    align-items: center; background-color: #FFFFFF; border-radius: 22px;
    padding: 12px 20px; margin: 8px; min-width: 150px;
}
.intro-glyph { font-size: 72px; color: #B5332E; -unity-text-align: middle-center; }
.intro-sound { font-size: 28px; -unity-font-style: bold; -unity-text-align: middle-center; }
.intro-pic { font-size: 44px; -unity-text-align: middle-center; margin-top: 4px; }
.warn {
    background-color: #FFF1C9; color: #7A5A00; border-radius: 14px; padding: 12px 16px;
    margin: 10px 0; white-space: normal; font-size: 24px;
}

/* ---------- lesson ---------- */
.progress { height: 18px; border-radius: 9px; background-color: #F0ECE6; overflow: hidden; }
.progress-fill { height: 100%; width: 0; background-color: #F28C38; border-radius: 9px; transition-duration: 0.3s; transition-property: width; }
.lesson-body { justify-content: center; }
.lesson-footer { padding: 16px 0 8px 0; border-radius: 22px; }
.lesson-footer.feedback { background-color: #E3F4E6; padding: 16px; }
.feedback-text { color: #2F7A3E; font-size: 28px; -unity-font-style: bold; white-space: normal; margin-bottom: 8px; }
.prompt { font-size: 30px; color: #8A8794; -unity-text-align: middle-center; white-space: normal; margin-bottom: 12px; }
.word-big { font-size: 96px; color: #2B2A33; -unity-text-align: middle-center; white-space: normal; margin: 12px 0; }
.hint { font-size: 30px; color: #B5332E; -unity-text-align: middle-center; min-height: 40px; }
.phrase-reveal { align-items: center; }
.result-stars { font-size: 96px; color: #F2A900; -unity-text-align: middle-center; margin: 20px 0; }

.options { flex-direction: row; flex-wrap: wrap; justify-content: center; margin-top: 20px; }
.option { margin: 8px; border-width: 3px; border-color: #F0ECE6; }
.option-glyph { width: 150px; height: 150px; font-size: 80px; -unity-font-style: normal; }
.option-word { width: 300px; height: 120px; font-size: 48px; -unity-font-style: normal; }
.option-text { width: 300px; min-height: 100px; white-space: normal; }
.option.right { border-color: #5BAE6A; background-color: #E3F4E6; }
.option.wrong { border-color: #D9534F; background-color: #FBE3E2; }
.option:disabled, .tile:disabled { opacity: 0.6; }
.option.right:disabled { opacity: 1; }

.slots { flex-direction: row; justify-content: center; margin: 24px 0; }
.slot {
    width: 96px; height: 116px; margin: 0 6px; font-size: 72px; color: #B5332E;
    -unity-text-align: middle-center; border-bottom-width: 5px; border-color: #F28C38;
}
.slot.filled { border-color: #5BAE6A; }
.tiles { flex-direction: row; flex-wrap: wrap; justify-content: center; }
.tile { width: 110px; height: 110px; margin: 8px; font-size: 60px; -unity-font-style: normal; border-width: 3px; border-color: #F0ECE6; }
.tile:disabled { opacity: 0.25; }
.tile-word { width: auto; min-width: 110px; height: 96px; padding: 0 22px; font-size: 44px; }
.sentence-built {
    font-size: 52px; color: #B5332E; -unity-text-align: middle-center; min-height: 80px;
    margin: 20px 0; border-bottom-width: 5px; border-color: #F28C38; padding-bottom: 8px;
}
.explain-card {
    background-color: #FFFFFF; border-radius: 28px; padding: 26px 28px; margin: 12px 0;
    border-left-width: 8px; border-color: #5B8FC7;
}
.explain-text { font-size: 30px; color: #2B2A33; margin: 8px 0; }
.shake { translate: 10px 0; background-color: #FBE3E2; border-color: #D9534F; }

/* Fixed-height bars must not be squeezed by the growing scroll area. */
.header, .topbar, .footer, .letter-detail, .lesson-footer { flex-shrink: 0; }

.wrap { white-space: normal; }
.gap-left { margin-left: 12px; }

/* deep letter explanation */
.more {
    background-color: #F6F1EA; border-radius: 14px; padding: 14px 18px; margin: 8px 0;
    font-size: 24px; white-space: normal; -unity-text-align: middle-left; align-self: stretch;
}

/* word intro */
.emoji-big { font-size: 72px; -unity-text-align: middle-center; }

/* review */
.review-card { border-color: #B5332E; background-color: #FFF1E6; }
.day-reviewfirst { opacity: 0.8; border-color: #F2C89B; }

/* dictionary */
.section-title { font-size: 30px; -unity-font-style: bold; color: #B5332E; margin: 18px 0 8px 0; }
.archive-row {
    flex-direction: row; align-items: center; background-color: #FFFFFF;
    border-radius: 18px; padding: 12px 16px; margin-bottom: 10px;
}
.archive-hy { font-size: 40px; white-space: normal; }
.archive-emoji { font-size: 44px; margin-right: 14px; }

/* back button on secondary screens */
.btn-back { background-color: #FFE7D1; color: #B5332E; font-size: 26px; padding: 10px 20px; margin: 0; }

/* shape association on letter cards */
.look {
    background-color: #EAF3FB; color: #24527A; border-radius: 14px; padding: 12px 16px;
    margin: 10px 0; white-space: normal; font-size: 24px; align-self: stretch;
}
.btn-back-round { width: 64px; height: 64px; border-radius: 32px; padding: 0; font-size: 40px; margin-right: 16px; }

/* ---------- landscape (PC, web, tablets) ----------
   AppRoot puts .landscape or .portrait on the root. Portrait is the base layout above;
   landscape keeps a readable centred column and uses the extra width where it helps. */
.full-row { width: 100%; }
.landscape .screen-host { align-items: center; }
.landscape .screen { width: 100%; max-width: 1500px; padding: 24px 48px; }

/* home: lessons in two columns */
.landscape .day-list { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.landscape .day-list > .day-card { width: 49.5%; }

/* alphabet: chosen letter on the left, grid on the right */
.landscape .alphabet-content { flex-direction: row; align-items: flex-start; }
.landscape .letter-detail { width: 44%; margin-right: 24px; margin-bottom: 0; }
.landscape .letter-grid { flex-grow: 1; flex-shrink: 1; flex-basis: 0; }

/* lessons and dictionary: not wider than comfortable reading */
.landscape .lesson-body, .landscape .lesson-footer { width: 100%; max-width: 1100px; align-self: center; }

/* ---------- Armenian vs Russian ----------
   Text that is only Armenian gets .hy (added by Ui.Label/Button); in mixed text the Armenian
   letters are bold and coloured through rich text (Ui.Mark). Russian stays plain ink. */
.hy { color: #B5332E; }
.letter-cell.hy { color: #A8A4AE; }
.letter-cell.learned.hy { color: #B5332E; }

/* part 3: Russian written partly in Armenian letters */
.mixed-text { font-size: 52px; -unity-text-align: middle-center; white-space: normal; margin: 20px 0; }
.plain-text { color: #8A8794; -unity-font-style: italic; }

/* parts of a day on the home screen */
.parts { font-size: 20px; color: #8A8794; margin-top: 4px; }

/* letters and words with mistakes */
.letter-cell.hard { background-color: #FFF1C9; }
.archive-row.hard { border-left-width: 8px; border-color: #F2A900; }

/* ---------- drawing a letter ---------- */
.draw-stage { justify-content: center; align-items: stretch; }
.draw-pad {
    width: 500px; height: 500px; align-self: center; flex-shrink: 0;
    background-color: #FFFFFF; border-radius: 28px; border-width: 3px; border-color: #F0ECE6;
    overflow: hidden;
}
.draw-guide, .draw-ink {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    -unity-background-image-tint-color: rgba(181, 51, 46, 0.2);
}
.draw-sound { font-size: 36px; color: #B5332E; -unity-text-align: middle-center; margin-bottom: 12px; }
.draw-note { font-size: 24px; color: #8A8794; -unity-text-align: middle-center; white-space: normal; min-height: 36px; margin-top: 8px; }
.draw-tools { flex-direction: row; justify-content: center; }

/* Mouse hover/press. The built-in theme greys out any hovered button (.unity-button:hover:enabled),
   so each style restates its own colour with a more specific selector. */
.btn:hover:enabled, .btn:hover:active:enabled { background-color: #FFF4EA; }
.btn.btn-primary:hover:enabled, .btn.btn-primary:hover:active:enabled,
.btn.btn-play:hover:enabled, .btn.btn-play:hover:active:enabled { background-color: #E07B28; }
.btn.btn-secondary:hover:enabled, .btn.btn-secondary:hover:active:enabled,
.btn.btn-back:hover:enabled, .btn.btn-back:hover:active:enabled { background-color: #FFDDBE; }
.btn.btn-ghost:hover:enabled, .btn.btn-ghost:hover:active:enabled,
.btn.btn-icon:hover:enabled, .btn.btn-icon:hover:active:enabled { background-color: rgba(181, 51, 46, 0.08); }
.btn.letter-cell:hover:enabled, .btn.letter-cell:hover:active:enabled { background-color: #E8E2DA; }
.btn.letter-cell.learned:hover:enabled, .btn.letter-cell.learned:hover:active:enabled { background-color: #FFF4EA; }
.btn.letter-cell.hard:hover:enabled, .btn.letter-cell.hard:hover:active:enabled { background-color: #FFEAB0; }
.btn.shake:hover:enabled, .btn.shake:hover:active:enabled { background-color: #FBE3E2; }

.landscape .draw-pad { width: 680px; height: 680px; }

/* ---------- reading ---------- */
.reading-item {
    -unity-text-align: middle-left; white-space: normal; font-size: 30px;
    padding: 20px 24px; margin: 6px 0; border-radius: 18px;
}
.reading-item.read { color: #8A8794; }
.reading-page { padding-bottom: 24px; }
.reading-title { font-size: 46px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; margin: 8px 0; }
.reading-text { font-size: 36px; white-space: normal; margin: 12px 0; -unity-text-align: upper-left; }
.landscape .reading-list { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.landscape .reading-list > .reading-item { width: 49.5%; }
.landscape .reading-page { max-width: 1100px; align-self: center; }

/* ---------- Armenian texts ---------- */
.settings { flex-wrap: wrap; justify-content: center; }
.hy-entry { margin: 12px 0 4px 0; }
.locked-note { font-size: 26px; color: #8A8794; background-color: #F3EEE8; border-radius: 18px; padding: 18px 22px; margin: 12px 0 4px 0; }
.hy-item { flex-direction: column; align-items: stretch; }
.hy-item-title { font-size: 32px; -unity-font-style: bold; color: #B5332E; white-space: normal; }
.hy-item.read .hy-item-title { color: #8A8794; }
.hy-item.famous { border-color: #D9A520; border-width: 3px; background-color: #FFF8E6; }
.hy-famous { font-size: 24px; color: #A87400; -unity-font-style: bold; white-space: normal; }
.hy-legend { font-size: 24px; color: #8A8794; -unity-text-align: middle-center; margin: 8px 0 12px 0; }
.hy-block { margin: 10px 0 18px 0; }
.hy-line { flex-direction: row; flex-wrap: wrap; }
.hy-word { font-size: 36px; color: #2B2A33; margin: 2px 12px 2px 0; padding: 0; border-radius: 8px; }
.hy-word.unknown { color: #B5332E; }
.hy-word:hover { background-color: rgba(242, 140, 56, 0.15); }
.word-popup {
    position: absolute; left: 16px; right: 16px; bottom: 16px;
    background-color: #FFFFFF; border-radius: 24px; padding: 24px 28px;
    border-width: 2px; border-color: #F28C38;
}
.landscape .word-popup { left: 25%; right: 25%; }
.popup-close { position: absolute; top: 6px; right: 6px; font-size: 30px; }
.popup-word { font-size: 40px; -unity-font-style: bold; margin-right: 48px; white-space: normal; }
.popup-meaning { font-size: 32px; margin: 6px 0; }
.popup-known { font-size: 26px; color: #3E8E5E; margin: 6px 0; }
